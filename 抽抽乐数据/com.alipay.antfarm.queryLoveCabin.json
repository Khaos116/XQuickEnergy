  "sleepTalkList": [
    {
      "text": "我最爱主人了，嘻嘻"
    },
    {
      "text": "想穿新衣服，呼呼"
    },
    {
      "text": "想要抱抱"
    },
    {
      "text": "晚上睡觉觉，白天精神好"
    },
    {
      "text": "好暖和好暖和呀~"
    },
    {
      "text": "本宝宝的小被子，香香软软的..."
    },
    {
      "text": "嘿嘿嘿，裹紧我可爱的小被叽~"
    },
    {
      "text": "嘻嘻我有小被子啦"
    },
    {
      "text": "主人说不可以蹬被子的..."
    },
    {
      "text": "感觉脚脚暖暖的~"
    },
    {
      "text": "别抢我的小被叽！"
    },
    {
      "text": "好软乎呀，呼呼..."
    },
    {
      "text": "主人主人，好暖呀！"
    },
    {
      "text": "盖暖暖被子，做甜甜的梦呀~"
    },
    {
      "text": "向右转！齐步走！"
    },
    {
      "text": "你住月球上，我住庄园里"
    },
    {
      "text": "床前明月光，疑是地上霜"
    },
    {
      "text": "主人，我梦见你啦！"
    },
    {
      "text": "我好喜欢我的主人呀！"
    },
    {
      "text": "哼哼，我寄几玩！"
    },
    {
      "text": "我对主人的爱是无穷大"
    },
    {
      "text": "好好吃饭，天天产蛋"
    },
    {
      "text": "主人好好看，嘿嘿嘿"
    },
    {
      "text": "我主人超腻害"
    },
    {
      "text": "咕咕咕咕咕咕..."
    },
    {
      "text": "一一得一，一二得二"
    },
    {
      "text": "呼呼呼，呼呼呼"
    },
    {
      "text": "我是宝宝"
    }
